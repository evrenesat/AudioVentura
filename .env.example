ACE_SERVICE_DATA_ROOT=/srv/ace-service/data
ACE_SERVICE_HOST=127.0.0.1
ACE_SERVICE_PORT=8000
ACE_TRANSFER_HOST=127.0.0.1
ACE_TRANSFER_PORT=8001
ACE_SERVICE_USERNAME=change-me
ACE_SERVICE_PASSWORD=change-me
ACE_SERVICE_PUBLIC_HOSTNAME=hetzner-name.tailnet-name.ts.net
ACE_TRANSFER_PUBLIC_BASE_URL=https://transfer.example.invalid
ACE_TRANSFER_TOKEN_TTL_SECONDS=14400
ACE_TRANSFER_MAX_SOURCE_BYTES=67108864
ACE_TRANSFER_MAX_OUTPUT_BYTES=268435456
ACE_HOME_INGEST_BASE_URL=https://home-name.tailnet-name.ts.net
ACE_HOME_INGEST_TOKEN=change-me
RUNPOD_API_KEY=change-me
RUNPOD_ENDPOINT_ID=change-me
INFERENCE_PROVIDER=runpod
INFERENCE_JOB_TIMEOUT_SECONDS=7200
RUNPOD_POLL_INTERVAL_SECONDS=2
RUNPOD_EXECUTION_TIMEOUT_MS=1200000
RUNPOD_JOB_TTL_MS=7200000
SALAD_API_KEY=change-me
SALAD_ORGANIZATION=change-me
SALAD_PROJECT=change-me
SALAD_QUEUE_NAME=audioventura-jobs
SALAD_CONTAINER_GROUP_NAME=audioventura-ace-step-v1
SALAD_POLL_INTERVAL_SECONDS=2
SALAD_CONNECT_TIMEOUT_SECONDS=5
SALAD_READ_TIMEOUT_SECONDS=30
SALAD_WRITE_TIMEOUT_SECONDS=30
SALAD_POOL_TIMEOUT_SECONDS=5
ACESTEP_MODEL=acestep-v15-xl-turbo
ACESTEP_LM_MODEL=acestep-5Hz-lm-1.7B
# Required with ACE_ELIGIBLE_GPU_IDS; pin the deployed worker image digest.
RUNPOD_WORKER_RUNTIME_IDENTITY=replace-with-sha256-digest
MAX_GENERATION_DURATION_SECONDS=600
MAX_SOURCE_DURATION_SECONDS=600
RETAIN_COVER_SOURCE=false
ACE_ELIGIBLE_GPU_IDS=["RTX4090","L40S"]
